# Zombie Outbreak - item templates for technologies in the Necrotech folder.
# The tech screen looks these up by name: techtree_<folder>_item / _small_item.
# They are top-level GUI types, so they can live in this separate file. The
# folder window and its tab button must be inside the vanilla
# countrytechtreeview window; tools/install.py adds those.

guiTypes = {

	containerWindowType = {
		name = "techtree_zombie_folder_item"
		position = { x=-66 y=-7 }
		size = { width = 203 height = 84 }
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite = "GFX_technology_unavailable_item_bg"
		}

		gridboxtype = {
			name = "special_project_specialization_list"
		}

		iconType = {
			name = "Icon"
			position = { x=101 y=50 }
			spriteType = "GFX_technology_medium"
			centerposition = yes
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "Name"
			position = { x = 6 y = 0 }
			font = "hoi_20bs"
			text = "Zombie"
			maxWidth = 190
			maxHeight = 20
			fixedsize = yes
			format = left
		}

		iconType = {
			name = "bonus_icon"
			position = { x=-78 y=-22 }
			spriteType = "GFX_tech_bonus"
			orientation = UPPER_RIGHT
		}
		instantTextBoxType = {
			name = "bonus"
			position = { x = -80 y = -18 }
			font = "hoi_16mbs"
			maxWidth = 77
			maxHeight = 20
			format = right
			orientation = UPPER_RIGHT
		}

		iconType = {
			name = "can_assign_design_team_icon"
			position = { x=4 y=-23 }
			spriteType = "GFX_design_team_icon_tech"
			orientation = LOWER_LEFT
		}
	}

	containerWindowType = {
		name = "techtree_zombie_folder_small_item"
		position = { x=0 y=0 }
		size = { width = 72 height = 72 }
		clipping = no

		background = {
			name = "bg"
			quadTextureSprite = "GFX_technology_unavailable_item_bg"
		}

		gridboxtype = {
			name = "special_project_specialization_list"
		}

		iconType = {
			name = "Icon"
			position = { x=3 y=3 }
			spriteType = "GFX_technology_medium"
			alwaystransparent = yes
		}

		iconType = {
			name = "bonus_icon"
			position = { x=-78 y=-22 }
			spriteType = "GFX_tech_bonus"
			orientation = UPPER_RIGHT
		}
		instantTextBoxType = {
			name = "bonus"
			position = { x = -80 y = -18 }
			font = "hoi_16mbs"
			maxWidth = 77
			maxHeight = 20
			format = right
			orientation = UPPER_RIGHT
		}

		iconType = {
			name = "can_assign_design_team_icon"
			position = { x=1 y=-23 }
			spriteType = "GFX_design_team_icon_tech"
			orientation = LOWER_LEFT
		}
	}
}
